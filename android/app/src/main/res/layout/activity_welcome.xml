<?xml version="1.0" encoding="utf-8"?>
<!-- Entry screen: brand hero with a sample queue ticket, then the sign-in options.
     Top corner: appearance + language buttons (work before signing in). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    tools:context=".WelcomeActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ===== Hero ===== -->
        <LinearLayout
            android:id="@+id/hero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_hero_welcome"
            android:clipChildren="false"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingBottom="28dp">

            <!-- top bar: brand at start, appearance + language at end -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="60dp"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="12dp">

                <FrameLayout
                    android:id="@+id/logoPlate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_logo_plate"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp">

                    <ImageView
                        android:layout_width="104dp"
                        android:layout_height="wrap_content"
                        android:adjustViewBounds="true"
                        android:contentDescription="@string/brand_name"
                        android:src="@drawable/logo_full" />
                </FrameLayout>

                <Space
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <FrameLayout
                    android:id="@+id/btnTheme"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_glass_circle"
                    android:clickable="true"
                    android:contentDescription="@string/cd_change_theme"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless">

                    <ImageView
                        android:id="@+id/themeIcon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_contrast"
                        app:tint="@color/white" />
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/btnLanguage"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_glass_pill"
                    android:clickable="true"
                    android:contentDescription="@string/cd_change_language"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="14dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_language"
                        app:tint="@color/white" />

                    <TextView
                        android:id="@+id/languageLabel"
                        style="@style/TextAppearance.SmartQ.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:importantForAccessibility="no"
                        android:textColor="@color/white" />
                </LinearLayout>
            </LinearLayout>

            <!-- sample ticket stage (decorative) -->
            <FrameLayout
                android:id="@+id/stage"
                android:layout_width="300dp"
                android:layout_height="190dp"
                android:layout_marginTop="12dp"
                android:clipChildren="false"
                android:importantForAccessibility="noHideDescendants">

                <com.example.smartquser.ui.TicketView
                    android:id="@+id/heroTicket"
                    android:layout_width="240dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:rotation="-3"
                    app:notchAnchor="@id/heroDivider"
                    app:ticketStyle="light">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="20dp"
                        android:paddingTop="16dp"
                        android:paddingEnd="20dp"
                        android:paddingBottom="16dp">

                        <TextView
                            style="@style/Text.Label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/welcome_your_turn"
                            android:textAlignment="viewStart" />

                        <TextView
                            android:id="@+id/heroQueue"
                            style="@style/Text.Display"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFeatureSettings="tnum"
                            android:text="@string/splash_queue_sample"
                            android:textColor="@color/accent"
                            android:textDirection="ltr"
                            android:textSize="38sp" />

                        <View
                            android:id="@+id/heroDivider"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="10dp"
                            android:layout_marginBottom="10dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_clinic"
                                app:tint="@color/teal_500" />

                            <TextView
                                android:id="@+id/heroPlace"
                                style="@style/Text.BodyStrong"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textAlignment="viewStart"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.example.smartquser.ui.TicketView>

                <LinearLayout
                    android:id="@+id/liveChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:background="@drawable/bg_chip_float"
                    android:elevation="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="7dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="7dp">

                    <View
                        android:id="@+id/liveDot"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_circle"
                        android:backgroundTint="@color/teal_500" />

                    <TextView
                        style="@style/Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/welcome_now_serving" />

                    <TextView
                        android:id="@+id/liveNumber"
                        style="@style/Text.H3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFeatureSettings="tnum"
                        android:textColor="@color/accent"
                        android:textDirection="ltr"
                        android:textSize="14sp" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <!-- ===== Copy + sign-in options ===== -->
        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="24dp"
            android:paddingEnd="24dp">

            <TextView
                android:id="@+id/title"
                style="@style/Text.H1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:breakStrategy="balanced"
                android:gravity="center"
                android:text="@string/welcome_title" />

            <TextView
                android:id="@+id/subtitle"
                style="@style/Text.Muted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="@string/welcome_subtitle"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvMessage"
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_pill"
                android:backgroundTint="@color/danger_tint"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingTop="10dp"
                android:paddingEnd="16dp"
                android:paddingBottom="10dp"
                android:textColor="@color/danger"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/buttons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEmail"
                    style="@style/Widget.SmartQ.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/continue_with_email"
                    app:icon="@drawable/ic_email" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPasswordPrimary"
                    style="@style/Widget.SmartQ.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sign_in_with_password"
                    android:visibility="gone"
                    app:icon="@drawable/ic_lock" />

                <FrameLayout
                    android:id="@+id/googleBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGoogle"
                        style="@style/Widget.SmartQ.Button.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/continue_with_google"
                        app:icon="@drawable/ic_google"
                        app:iconSize="20dp"
                        app:iconTint="@null" />

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/googleProgress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:elevation="8dp"
                        android:indeterminate="true"
                        android:visibility="gone"
                        app:indicatorColor="@color/accent"
                        app:indicatorSize="24dp"
                        app:trackThickness="3dp" />
                </FrameLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGuest"
                    style="@style/Widget.SmartQ.Button.Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:minHeight="48dp"
                    android:text="@string/welcome_guest"
                    android:textColor="@color/ink_soft"
                    app:icon="@drawable/ic_arrow_forward"
                    app:iconGravity="textEnd"
                    app:iconSize="18dp"
                    app:iconTint="@color/ink_soft" />
            </LinearLayout>
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="12dp" />

        <LinearLayout
            android:id="@+id/footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/footerText"
                style="@style/Text.Muted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/welcome_have_password" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPassword"
                style="@style/Widget.SmartQ.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/sign_in_with_password" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
