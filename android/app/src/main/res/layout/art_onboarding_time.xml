<?xml version="1.0" encoding="utf-8"?>
<!-- Onboarding 2 "Pick your exact time": a day card with time slots (built in code). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="300dp"
    android:layout_height="300dp"
    android:layout_gravity="center"
    android:clipChildren="false"
    android:importantForAccessibility="noHideDescendants">

    <View
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:layout_gravity="center"
        android:background="@drawable/splash_ring" />

    <LinearLayout
        android:id="@+id/dayCard"
        android:layout_width="244dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_skeleton_card"
        android:elevation="6dp"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_icon_tile"
                android:backgroundTint="@color/blue_tint">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_calendar"
                    app:tint="@color/accent" />
            </FrameLayout>

            <TextView
                style="@style/Text.H3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="@string/date_today"
                android:textSize="16sp" />

            <TextView
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/onb_art_free" />
        </LinearLayout>

        <GridLayout
            android:id="@+id/slotGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:columnCount="3"
            android:layoutDirection="ltr" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/hourglassBubble"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/bg_skeleton_card"
        android:elevation="8dp">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_clock"
            app:tint="@color/teal_500" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/pickedChip"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="2dp"
        android:background="@drawable/bg_chip_float"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="16dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_check"
            app:tint="@color/teal_500" />

        <TextView
            android:id="@+id/pickedText"
            style="@style/Text.BodyStrong"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>
