<?xml version="1.0" encoding="utf-8"?>
<!-- Onboarding: colored slides (illustration panel + title + one line), arrows, dots and Skip. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    tools:context=".OnboardingActivity">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- top bar over the colored panel: brand + Skip -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="8dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="32dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_mark" />

        <TextView
            style="@style/Text.H3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="@string/brand_name"
            android:textAlignment="viewStart"
            android:textColor="@color/white" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSkip"
            style="@style/Widget.SmartQ.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/action_skip"
            android:textColor="@color/white"
            app:rippleColor="@color/white_20" />
    </LinearLayout>

    <!-- bottom controls: ← dots → -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_vertical"
        android:minHeight="96dp"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPrev"
            style="@style/Widget.Material3.Button.IconButton.Outlined"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@string/action_previous"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            app:icon="@drawable/ic_arrow_back"
            app:iconSize="24dp"
            app:iconTint="@color/ink"
            app:shapeAppearance="@style/Shape.SmartQ.Circle"
            app:strokeColor="@color/border"
            app:strokeWidth="1.5dp" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <com.example.smartquser.ui.PageIndicatorView
                android:id="@+id/indicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:padding="4dp" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="56dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNext"
                style="@style/Widget.Material3.Button.IconButton.Filled"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="end|center_vertical"
                android:contentDescription="@string/action_next"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:stateListAnimator="@animator/press_scale"
                app:backgroundTint="@color/blue_600"
                app:icon="@drawable/ic_arrow_forward"
                app:iconSize="24dp"
                app:iconTint="@color/white"
                app:shapeAppearance="@style/Shape.SmartQ.Circle" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStart"
                style="@style/Widget.SmartQ.Button"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_gravity="end|center_vertical"
                android:paddingStart="24dp"
                android:paddingEnd="20dp"
                android:text="@string/onb_get_started"
                android:visibility="gone"
                app:icon="@drawable/ic_arrow_forward"
                app:iconGravity="textEnd"
                app:iconSize="20dp" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
