<?xml version="1.0" encoding="utf-8"?>
<!-- RecyclerView item entrance: fade + slide up, used by layout_stagger. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="460" android:interpolator="@android:interpolator/decelerate_cubic">
    <translate android:fromYDelta="24dp" android:toYDelta="0" />
    <alpha android:fromAlpha="0" android:toAlpha="1" />
</set>
