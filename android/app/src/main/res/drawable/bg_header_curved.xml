<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="@color/navy_900" android:centerColor="@color/blue_600" android:endColor="@color/teal_500" />
            <corners android:bottomLeftRadius="32dp" android:bottomRightRadius="32dp" />
        </shape>
    </item>
    <item android:gravity="top|end" android:width="220dp" android:height="220dp" android:top="-70dp" android:end="-70dp">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="110dp" android:startColor="#3314A39A" android:endColor="#0014A39A" />
        </shape>
    </item>
    <item android:gravity="bottom|start" android:width="180dp" android:height="180dp" android:start="-60dp" android:bottom="-40dp">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="90dp" android:startColor="#338EC5FF" android:endColor="#008EC5FF" />
        </shape>
    </item>
</layer-list>
